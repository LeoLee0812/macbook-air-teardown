[
 {
  "id": "s01",
  "text": "这是 13 英寸的 M5 MacBook Air。我们把它拆开看看。",
  "start": 4.35,
  "dur": 6.1,
  "end": 10.45,
  "tempo": 1.05,
  "raw": 6.408,
  "over": 0.0
 },
 {
  "id": "s02",
  "text": "厚 1.13 厘米，重 1.23 千克。",
  "start": 10.6,
  "dur": 3.587,
  "end": 14.187,
  "tempo": 1.0,
  "raw": 3.587,
  "over": -0.563
 },
 {
  "id": "s03",
  "text": "把它翻过来，底壳由四颗五角螺丝固定。内侧还有四个卡扣，用吸盘轻轻拉起。",
  "start": 14.337,
  "dur": 7.615,
  "end": 21.952,
  "tempo": 1.0,
  "raw": 7.615,
  "over": -2.348
 },
 {
  "id": "s04",
  "text": "打开底壳，电池、主板、触控板，一目了然。",
  "start": 23.95,
  "dur": 5.15,
  "end": 29.1,
  "tempo": 1.099,
  "raw": 5.658,
  "over": 0.0
 },
 {
  "id": "s05",
  "text": "动手之前，先断开电池。",
  "start": 29.25,
  "dur": 2.532,
  "end": 31.782,
  "tempo": 1.0,
  "raw": 2.532,
  "over": -0.268
 },
 {
  "id": "s06",
  "text": "电池由四块电芯组成，容量 53.8 瓦时。靠易拉胶和螺丝固定，拉出拉片就能取下。",
  "start": 31.932,
  "dur": 7.6,
  "end": 39.532,
  "tempo": 1.0,
  "raw": 7.6,
  "over": -2.318
 },
 {
  "id": "s07",
  "text": "触控板下面是触感引擎，按压的咔哒感，是它模拟的。",
  "start": 41.4,
  "dur": 5.327,
  "end": 46.727,
  "tempo": 1.0,
  "raw": 5.327,
  "over": -0.923
 },
 {
  "id": "s08",
  "text": "两个雷雳接口，各有独立小板。",
  "start": 47.2,
  "dur": 2.933,
  "end": 50.133,
  "tempo": 1.0,
  "raw": 2.933,
  "over": -1.367
 },
 {
  "id": "s09",
  "text": "充电口也是。",
  "start": 51.05,
  "dur": 1.222,
  "end": 52.272,
  "tempo": 1.0,
  "raw": 1.222,
  "over": -1.178
 },
 {
  "id": "s10",
  "text": "扬声器在铰链两侧，天线就藏在里面。",
  "start": 53.0,
  "dur": 3.936,
  "end": 56.936,
  "tempo": 1.0,
  "raw": 3.936,
  "over": -0.514
 },
 {
  "id": "s11",
  "text": "主板细细一条，横在铰链一侧。",
  "start": 57.086,
  "dur": 3.534,
  "end": 60.62,
  "tempo": 1.0,
  "raw": 3.534,
  "over": -1.23
 },
 {
  "id": "s12",
  "text": "没有风扇，芯片的热量全靠热模块导走。",
  "start": 61.4,
  "dur": 4.794,
  "end": 66.194,
  "tempo": 1.0,
  "raw": 4.794,
  "over": -0.356
 },
 {
  "id": "s13",
  "text": "还有硬盘和无线芯片。",
  "start": 66.344,
  "dur": 2.738,
  "end": 69.082,
  "tempo": 1.0,
  "raw": 2.738,
  "over": -0.068
 },
 {
  "id": "s14",
  "text": "触控 ID 和耳机孔，藏在主板下面。",
  "start": 69.232,
  "dur": 3.768,
  "end": 73.0,
  "tempo": 1.0,
  "raw": 3.768,
  "over": -0.3
 },
 {
  "id": "s15",
  "text": "最后是屏幕：13.6 英寸，亮度 500 尼特。",
  "start": 73.3,
  "dur": 4.43,
  "end": 77.73,
  "tempo": 1.0,
  "raw": 4.43,
  "over": -1.27
 },
 {
  "id": "s16",
  "text": "刘海里，是 1200 万像素摄像头。",
  "start": 78.55,
  "dur": 3.997,
  "end": 82.547,
  "tempo": 1.15,
  "raw": 4.596,
  "over": 0.097
 },
 {
  "id": "s17",
  "text": "松开铰链，屏幕就能取下。",
  "start": 82.697,
  "dur": 2.843,
  "end": 85.539,
  "tempo": 1.15,
  "raw": 3.269,
  "over": 0.489
 },
 {
  "id": "s18",
  "text": "剩下的，是顶壳和键盘。它们是一体的，换键盘，就得换整个顶壳。",
  "start": 85.689,
  "dur": 7.011,
  "end": 92.7,
  "tempo": 1.088,
  "raw": 7.626,
  "over": 0.0
 },
 {
  "id": "s19",
  "text": "这就是一台 MacBook Air 的全部主要零件。",
  "start": 92.85,
  "dur": 4.427,
  "end": 97.277,
  "tempo": 1.0,
  "raw": 4.427,
  "over": -0.223
 },
 {
  "id": "s20",
  "text": "每一块，都刚好待在它该在的地方。",
  "start": 98.0,
  "dur": 3.67,
  "end": 101.67,
  "tempo": 1.0,
  "raw": 3.67,
  "over": -0.83
 },
 {
  "id": "s21",
  "text": "机身之所以这么薄，是零件一层层让出来的。",
  "start": 108.5,
  "dur": 4.047,
  "end": 112.547,
  "tempo": 1.0,
  "raw": 4.047,
  "over": -1.553
 },
 {
  "id": "s22",
  "text": "MacBook Air，拆解完毕。",
  "start": 119.0,
  "dur": 2.315,
  "end": 121.315,
  "tempo": 1.0,
  "raw": 2.315,
  "over": -0.885
 }
]