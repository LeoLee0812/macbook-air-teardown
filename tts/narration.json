{
 "voice": "longsanshu_v3.1",
 "text_prompt": "沉稳、清晰、有质感的男声，像科技纪录片的解说，语速适中偏快，句尾自然收住，不要播音腔，不要夸张",
 "segments": [
  {
   "id": "s01",
   "t": 4.35,
   "end": 9.85,
   "text": "这是 13 英寸的 M5 MacBook Air。我们把它拆开看看。"
  },
  {
   "id": "s02",
   "t": 10.0,
   "end": 13.85,
   "text": "厚 1.13 厘米，重 1.23 千克。"
  },
  {
   "id": "s03",
   "t": 14.3,
   "end": 23.4,
   "text": "翻过来，底壳由四颗五角螺丝固定。内侧还有四个卡扣，用吸盘轻轻拉起。"
  },
  {
   "id": "s04",
   "t": 23.95,
   "end": 28.45,
   "text": "打开底壳，电池、主板、触控板，一目了然。"
  },
  {
   "id": "s05",
   "t": 28.65,
   "end": 31.4,
   "text": "动手之前，先断开电池。"
  },
  {
   "id": "s06",
   "t": 31.6,
   "end": 41.05,
   "text": "电池由四块电芯组成，容量 53.8 瓦时。靠易拉胶和螺丝固定，拉出拉片就能取下。"
  },
  {
   "id": "s07",
   "t": 41.4,
   "end": 47.0,
   "text": "触控板下面是触感引擎，按压的咔哒感，是它模拟的。"
  },
  {
   "id": "s08",
   "t": 47.2,
   "end": 50.9,
   "text": "两个雷雳接口，各有独立小板。"
  },
  {
   "id": "s09",
   "t": 51.05,
   "end": 52.9,
   "text": "磁吸充电口也是。"
  },
  {
   "id": "s10",
   "t": 53.0,
   "end": 56.8,
   "text": "扬声器在铰链两侧，天线就藏在里面。"
  },
  {
   "id": "s11",
   "t": 57.0,
   "end": 61.2,
   "text": "主板细细一条，横在铰链一侧。"
  },
  {
   "id": "s12",
   "t": 61.4,
   "end": 66.0,
   "text": "没有风扇，芯片的热量全靠热模块导走。"
  },
  {
   "id": "s13",
   "t": 66.1,
   "end": 68.5,
   "text": "还有硬盘和无线芯片。"
  },
  {
   "id": "s14",
   "t": 68.7,
   "end": 72.4,
   "text": "触控 ID 和耳机孔，藏在主板下面。"
  },
  {
   "id": "s15",
   "t": 73.3,
   "end": 78.3,
   "text": "最后是屏幕：13.6 英寸，亮度 500 尼特。"
  },
  {
   "id": "s16",
   "t": 78.55,
   "end": 81.85,
   "text": "刘海里，是 1200 万像素摄像头。"
  },
  {
   "id": "s17",
   "t": 82.0,
   "end": 84.15,
   "text": "拧下铰链，屏幕取下。"
  },
  {
   "id": "s18",
   "t": 84.6,
   "end": 91.8,
   "text": "剩下的，是顶壳和键盘。它们是一体的，换键盘，就得换整个顶壳。"
  },
  {
   "id": "s19",
   "t": 92.6,
   "end": 96.6,
   "text": "这就是一台 MacBook Air 的全部主要零件。"
  },
  {
   "id": "s20",
   "t": 98.0,
   "end": 101.6,
   "text": "每一块，都刚好待在它该在的地方。"
  },
  {
   "id": "s21",
   "t": 108.5,
   "end": 113.2,
   "text": "机身之所以这么薄，是零件一层层让出来的。"
  },
  {
   "id": "s22",
   "t": 119.0,
   "end": 121.3,
   "text": "MacBook Air，拆解完毕。"
  }
 ],
 "lead": "，"
}