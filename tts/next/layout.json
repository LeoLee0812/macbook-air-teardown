[
 {
  "id": "s01",
  "text": "这是 13 英寸的 M5 MacBook Air。我们把它拆开看看。",
  "start": 4.35,
  "dur": 3.627,
  "end": 7.977,
  "tempo": 1.0,
  "raw": 3.627,
  "over": -2.473
 },
 {
  "id": "s02",
  "text": "厚 1.13 厘米，重 1.23 千克。",
  "start": 10.0,
  "dur": 3.265,
  "end": 13.265,
  "tempo": 1.0,
  "raw": 3.265,
  "over": -1.485
 },
 {
  "id": "s03",
  "text": "把它翻过来，底壳由四颗五角螺丝固定。内侧还有四个卡扣，用吸盘轻轻拉起。",
  "start": 14.3,
  "dur": 5.682,
  "end": 19.982,
  "tempo": 1.0,
  "raw": 5.682,
  "over": -4.318
 },
 {
  "id": "s04",
  "text": "打开底壳，电池、主板、触控板，一目了然。",
  "start": 23.95,
  "dur": 3.484,
  "end": 27.434,
  "tempo": 1.0,
  "raw": 3.484,
  "over": -1.666
 },
 {
  "id": "s05",
  "text": "动手之前，先断开电池。",
  "start": 28.65,
  "dur": 1.836,
  "end": 30.486,
  "tempo": 1.0,
  "raw": 1.836,
  "over": -1.564
 },
 {
  "id": "s06",
  "text": "电池由四块电芯组成，容量 53.8 瓦时。靠易拉胶和螺丝固定，拉出拉片就能取下。",
  "start": 31.6,
  "dur": 5.948,
  "end": 37.548,
  "tempo": 1.0,
  "raw": 5.948,
  "over": -4.302
 },
 {
  "id": "s07",
  "text": "触控板下面是触感引擎，按压的咔哒感，是它模拟的。",
  "start": 41.4,
  "dur": 4.023,
  "end": 45.423,
  "tempo": 1.0,
  "raw": 4.023,
  "over": -2.227
 },
 {
  "id": "s08",
  "text": "两个雷雳接口，各有独立小板。",
  "start": 47.2,
  "dur": 2.179,
  "end": 49.379,
  "tempo": 1.0,
  "raw": 2.179,
  "over": -2.121
 },
 {
  "id": "s09",
  "text": "充电口也是。",
  "start": 51.05,
  "dur": 1.249,
  "end": 52.299,
  "tempo": 1.0,
  "raw": 1.249,
  "over": -1.151
 },
 {
  "id": "s10",
  "text": "扬声器在铰链两侧，天线就藏在里面。",
  "start": 53.0,
  "dur": 2.836,
  "end": 55.836,
  "tempo": 1.0,
  "raw": 2.836,
  "over": -1.614
 },
 {
  "id": "s11",
  "text": "主板细细一条，横在铰链一侧。",
  "start": 57.0,
  "dur": 2.944,
  "end": 59.944,
  "tempo": 1.0,
  "raw": 2.944,
  "over": -1.906
 },
 {
  "id": "s12",
  "text": "没有风扇，芯片的热量全靠热模块导走。",
  "start": 61.4,
  "dur": 3.39,
  "end": 64.79,
  "tempo": 1.0,
  "raw": 3.39,
  "over": -1.76
 },
 {
  "id": "s13",
  "text": "还有硬盘和无线芯片。",
  "start": 66.1,
  "dur": 1.936,
  "end": 68.036,
  "tempo": 1.0,
  "raw": 1.936,
  "over": -1.114
 },
 {
  "id": "s14",
  "text": "触控 ID 和耳机孔，藏在主板下面。",
  "start": 68.7,
  "dur": 2.754,
  "end": 71.454,
  "tempo": 1.0,
  "raw": 2.754,
  "over": -1.846
 },
 {
  "id": "s15",
  "text": "最后是屏幕：13.6 英寸，亮度 500 尼特。",
  "start": 73.3,
  "dur": 4.33,
  "end": 77.63,
  "tempo": 1.0,
  "raw": 4.33,
  "over": -1.37
 },
 {
  "id": "s16",
  "text": "刘海里，是 1200 万像素摄像头。",
  "start": 78.55,
  "dur": 2.407,
  "end": 80.957,
  "tempo": 1.0,
  "raw": 2.407,
  "over": -1.493
 },
 {
  "id": "s17",
  "text": "松开铰链，屏幕就能取下。",
  "start": 82.0,
  "dur": 2.325,
  "end": 84.325,
  "tempo": 1.0,
  "raw": 2.325,
  "over": -0.725
 },
 {
  "id": "s18",
  "text": "剩下的，是顶壳和键盘。它们是一体的，换键盘，就得换整个顶壳。",
  "start": 84.6,
  "dur": 6.42,
  "end": 91.02,
  "tempo": 1.0,
  "raw": 6.42,
  "over": -1.68
 },
 {
  "id": "s19",
  "text": "这就是一台 MacBook Air 的全部主要零件。",
  "start": 92.6,
  "dur": 3.02,
  "end": 95.62,
  "tempo": 1.0,
  "raw": 3.02,
  "over": -1.88
 },
 {
  "id": "s20",
  "text": "每一块，都刚好待在它该在的地方。",
  "start": 98.0,
  "dur": 2.804,
  "end": 100.804,
  "tempo": 1.0,
  "raw": 2.804,
  "over": -1.696
 },
 {
  "id": "s21",
  "text": "机身之所以这么薄，是零件一层层让出来的。",
  "start": 108.5,
  "dur": 2.838,
  "end": 111.338,
  "tempo": 1.0,
  "raw": 2.838,
  "over": -2.762
 },
 {
  "id": "s22",
  "text": "MacBook Air，拆解完毕。",
  "start": 119.0,
  "dur": 2.28,
  "end": 121.28,
  "tempo": 1.0,
  "raw": 2.28,
  "over": -0.92
 }
]